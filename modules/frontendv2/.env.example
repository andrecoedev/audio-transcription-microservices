# API Configuration
VITE_API_URL=http://localhost:2020

# Application Settings
VITE_APP_NAME=Transcritor AI
VITE_APP_VERSION=2.0.0

# Feature Flags
VITE_ENABLE_AUTH=false
VITE_ENABLE_ANALYTICS=false
# Public Web configuration only. FIREBASE_API_KEY/AUTH_DOMAIN/PROJECT_ID/APP_ID
# are compatibility aliases; npm also reads these four from ../backend/.env.
# Non-empty VITE_FIREBASE_* values take precedence. Never add an Admin private key.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
