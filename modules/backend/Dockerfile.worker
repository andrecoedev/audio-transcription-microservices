FROM nvidia/cuda:12.3.2-cudnn9-runtime-ubuntu22.04

WORKDIR /app

RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python-is-python3 \
    ffmpeg \
    libsndfile1 \
    bash \
    && rm -rf /var/lib/apt/lists/*

COPY modules/backend/requirements.txt /app/requirements.txt
RUN python -m pip install --no-cache-dir --upgrade \
    pip==26.2.1 setuptools==83.0.0 wheel==0.46.3
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY . /app
RUN mkdir -p /app/modules/backend/database /app/modules/backend/temp /app/modules/backend/logs

WORKDIR /app/modules/backend
CMD ["python", "run_worker.py"]
