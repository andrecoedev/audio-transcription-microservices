# Production environment template
APP_ENV=prod
API_HOST=0.0.0.0
API_PORT=2020
DEBUG=False

# REQUIRED secrets
# Generate SECRET_KEY with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Provider keys (set according to enabled features)
HF_TOKEN=
AAI_API_KEY=
GEMINI_API_KEY=

# Database (required; secrets must be supplied by the deployment environment)
POSTGRES_DB=transcription_db
POSTGRES_USER=transcription
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://transcription:replace-me@postgres:5432/transcription_db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# Redis / RQ
REDIS_URL=redis://redis:6379/0

# JWT
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=usagi-api
JWT_AUDIENCE=usagi-web
CORS_ALLOWED_ORIGINS=https://app.example.com
HF_TOKEN_CONFIGURED=false
AAI_API_KEY_CONFIGURED=false
GEMINI_API_KEY_CONFIGURED=false
GEMINI_MODEL=gemini-2.5-flash
INTELLIGENCE_MAX_INPUT_CHARACTERS=200000
LOGIN_RATE_LIMIT_PER_IP=30
LOGIN_RATE_LIMIT_PER_ACCOUNT=10
UPLOAD_RATE_LIMIT_PER_IP=300
JOB_RATE_LIMIT_PER_USER=30
CORS_ALLOW_CREDENTIALS=false

# Auth rollout
AUTH_MODE=strict
AUTH_PROTECT_API_KEYS=true
AUTH_PROTECT_PROCESSING=true
AUTH_PROTECT_READS=true
FIREBASE_AUTH_ENABLED=false
# Candidate project ID only; replace with the Firebase project ID when enabling.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_HTTP_TIMEOUT_SECONDS=10
# Public Firebase Web config (embedded in the frontend build; never put an Admin key here).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_EMAIL=admin@example.com
# Prefer hash in production
AUTH_ADMIN_PASSWORD_HASH=
AUTH_ALLOW_DEMO_LOGIN=false

# Upload/processing
MAX_UPLOAD_SIZE_MB=5120
ALLOWED_EXTENSIONS=mp3,wav,mp4,mpeg,m4a,flac,ogg,opus
AUDIO_UPLOAD_DIRECTORY=database/uploads
AUDIO_ORPHAN_RETENTION_HOURS=24
TRANSCRIPTION_RETENTION_DAYS=0
AUDIT_RETENTION_DAYS=0
DEFAULT_TRANSCRIPTION_MODEL=whisper
MIN_SEGMENT_DURATION=0
SILENCE_THRESHOLD=-100
MEETING_MINUTES_TIMEOUT_SECONDS=600

# GPU
FORCE_CPU=false
GPU_MEMORY_FRACTION=0.8
# Local Whisper worker (P1-B)
WHISPER_MODEL=large-v3
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_LANGUAGE=pt
WHISPER_BEAM_SIZE=1
WHISPER_MAX_DECODE_CHUNK_SECONDS=300
WHISPER_CPU_THREADS=0
