# Production environment template
APP_ENV=prod
API_HOST=0.0.0.0
API_PORT=2020
DEBUG=False

# REQUIRED secrets
# Generate SECRET_KEY with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ENCRYPTION_KEY=

# Provider keys (set according to enabled features)
HF_TOKEN=
AAI_API_KEY=
GEMINI_API_KEY=

# Database (PostgreSQL recommended)
DATABASE_URL=postgresql://user:password@db:5432/transcription_db

# Redis / RQ
REDIS_URL=redis://redis:6379/0

# JWT
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Auth rollout
AUTH_MODE=strict
AUTH_PROTECT_API_KEYS=true
AUTH_PROTECT_PROCESSING=true
AUTH_PROTECT_READS=true
AUTH_ADMIN_USERNAME=admin
# Prefer hash in production
AUTH_ADMIN_PASSWORD_HASH=
AUTH_ALLOW_DEMO_LOGIN=false

# Upload/processing
MAX_UPLOAD_SIZE_MB=5120
ALLOWED_EXTENSIONS=mp3,wav,mp4,mpeg,m4a,flac,ogg,opus
DEFAULT_TRANSCRIPTION_MODEL=whisper
MIN_SEGMENT_DURATION=0
SILENCE_THRESHOLD=-100
MEETING_MINUTES_TIMEOUT_SECONDS=600

# GPU
FORCE_CPU=false
GPU_MEMORY_FRACTION=0.8
# Local Whisper worker (P1-B)
WHISPER_MODEL=large-v3
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_LANGUAGE=pt
WHISPER_BEAM_SIZE=1
WHISPER_MAX_DECODE_CHUNK_SECONDS=300
WHISPER_CPU_THREADS=0
