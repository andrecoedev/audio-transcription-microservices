FROM python:3.11-slim

WORKDIR /app

COPY modules/backend/requirements.api.txt /app/requirements.api.txt
RUN python -m pip install --no-cache-dir --upgrade \
    pip==26.2.1 setuptools==83.0.0 wheel==0.46.3
RUN pip install --no-cache-dir -r /app/requirements.api.txt

COPY . /app
RUN mkdir -p /app/modules/backend/database /app/modules/backend/temp /app/modules/backend/logs

WORKDIR /app/modules/backend
EXPOSE 2020

CMD ["python", "-m", "uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "2020"]
