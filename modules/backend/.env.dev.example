# Development environment template
APP_ENV=dev
API_HOST=0.0.0.0
API_PORT=2020
DEBUG=True

# Secrets (set your own values)
# Generate SECRET_KEY with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
HF_TOKEN=
AAI_API_KEY=
GEMINI_API_KEY=

# Database
DATABASE_URL=sqlite:///./database/transcriptions.db

# Redis / RQ
REDIS_URL=redis://localhost:6379/0

# JWT
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Auth rollout
AUTH_MODE=permissive
AUTH_PROTECT_API_KEYS=true
AUTH_PROTECT_PROCESSING=true
AUTH_PROTECT_READS=false

# Admin credentials (NEVER commit real credentials, even in example files)
# For development only - set your own strong password
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=
# AUTH_ADMIN_PASSWORD_HASH=
AUTH_ALLOW_DEMO_LOGIN=true

# Optional encrypted key storage (recommended even in dev)
ENCRYPTION_KEY=

# Upload/processing
MAX_UPLOAD_SIZE_MB=5120
ALLOWED_EXTENSIONS=mp3,wav,mp4,mpeg,m4a,flac,ogg,opus
DEFAULT_TRANSCRIPTION_MODEL=whisper
MIN_SEGMENT_DURATION=0.7
SILENCE_THRESHOLD=-30
MEETING_MINUTES_TIMEOUT_SECONDS=600

# GPU
FORCE_CPU=false
GPU_MEMORY_FRACTION=0.8
WHISPER_DTYPE=auto
