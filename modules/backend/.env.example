# Legacy combined template.
# Prefer one of:
# - .env.dev.example
# - .env.prod.example

# API Keys
HF_TOKEN=your_huggingface_token_here
AAI_API_KEY=your_assemblyai_api_key_here

# Database Configuration
DATABASE_URL=sqlite:///./database/transcriptions.db
# Para PostgreSQL: postgresql://user:password@localhost:5432/transcription_db

# Redis & Job Queue (RQ)
REDIS_URL=redis://localhost:6379/0

# API Configuration
APP_ENV=dev
API_HOST=0.0.0.0
API_PORT=2020
DEBUG=False

# Security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Auth rollout
AUTH_MODE=permissive
AUTH_PROTECT_API_KEYS=true
AUTH_PROTECT_PROCESSING=true
AUTH_PROTECT_READS=false
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=
# AUTH_ADMIN_PASSWORD_HASH=
AUTH_ALLOW_DEMO_LOGIN=true

# Optional: required for safer encrypted key storage in production
ENCRYPTION_KEY=

# File Upload Configuration
MAX_UPLOAD_SIZE_MB=5120
ALLOWED_EXTENSIONS=mp3,wav,mp4,mpeg,m4a,flac

# Processing Configuration
DEFAULT_TRANSCRIPTION_MODEL=whisper
MIN_SEGMENT_DURATION=0.7
SILENCE_THRESHOLD=-30
MEETING_MINUTES_TIMEOUT_SECONDS=600

# Local Whisper worker (P1-B)
TRANSCRIPTION_ENGINE=faster-whisper
WHISPER_MODEL=large-v3
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_LANGUAGE=pt
WHISPER_BEAM_SIZE=1
WHISPER_MAX_DECODE_CHUNK_SECONDS=300
WHISPER_CPU_THREADS=0
# Used only when TRANSCRIPTION_ENGINE=huggingface
WHISPER_DTYPE=auto
