# Legacy combined template.
# Prefer one of:
# - .env.dev.example
# - .env.prod.example

# API Keys
HF_TOKEN=your_huggingface_token_here
AAI_API_KEY=your_assemblyai_api_key_here

# Database Configuration (PostgreSQL is the official runtime)
POSTGRES_DB=transcription_db
POSTGRES_USER=transcription
POSTGRES_PASSWORD=change-this-local-password
# Used when running API/Alembic outside Compose; Compose injects host `postgres`.
DATABASE_URL=postgresql+psycopg://transcription:change-this-local-password@localhost:5432/transcription_db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
USAGE_SPOOL_DIRECTORY=database/usage-spool

# Redis & Job Queue (RQ)
REDIS_URL=redis://localhost:6379/0

# API Configuration
APP_ENV=dev
API_HOST=0.0.0.0
API_PORT=2020
DEBUG=False

# Security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=usagi-api
JWT_AUDIENCE=usagi-web
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
HF_TOKEN_CONFIGURED=false
AAI_API_KEY_CONFIGURED=false
AAI_PLATFORM_ENABLED=false
# Independent Fernet key shared only by API/Worker; never reuse SECRET_KEY.
# Empty disables BYOK writes/execution; do not send this value to clients.
PROVIDER_CREDENTIAL_ENCRYPTION_KEY=
# Legacy compatibility only: Guest is demo-only; true does not enable inference.
AAI_GUEST_ENABLED=false
# Cumulative ceiling, never reset by deletion/restart. Explicit operator approval.
AAI_PLATFORM_BUDGET_CENTS=0
AAI_MAX_AUDIO_SECONDS=600
AAI_TIMEOUT_SECONDS=180
AAI_HTTP_TIMEOUT_SECONDS=30
AAI_POLL_INTERVAL_SECONDS=3
GEMINI_API_KEY_CONFIGURED=false
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_API_KEY_CONFIGURED=false
GROQ_PLATFORM_ENABLED=false
GROQ_PLATFORM_BUDGET_CENTS=0
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=60
GROQ_MAX_INPUT_CHARACTERS=20000
GROQ_MAX_INPUT_TOKENS=32000
GROQ_MAX_OUTPUT_TOKENS=4096
GROQ_MAX_ACTIVE_PER_USER=0
GROQ_MAX_PROCESSING_PER_USER=0
# Explicit operator-reviewed USD ceilings; not automatic tariffs or invoices.
GROQ_INPUT_USD_PER_MILLION=0
GROQ_OUTPUT_USD_PER_MILLION=0
INTELLIGENCE_MAX_INPUT_CHARACTERS=200000
LOGIN_RATE_LIMIT_PER_IP=30
LOGIN_RATE_LIMIT_PER_ACCOUNT=10
UPLOAD_RATE_LIMIT_PER_IP=300
JOB_RATE_LIMIT_PER_USER=30
# Public account processing limits and legacy Guest retention; not paid plans.
SIGNUP_RATE_LIMIT_PER_IP=5
PUBLIC_MAX_UPLOAD_MB=100
PUBLIC_MAX_AUDIO_SECONDS=600
PUBLIC_JOB_TIMEOUT_SECONDS=300
PUBLIC_JOB_RATE_LIMIT_PER_IP=3
PUBLIC_JOB_RATE_LIMIT_GLOBAL=10
GUEST_SESSION_RATE_LIMIT_PER_IP=5
GUEST_RETENTION_HOURS=24
GUEST_JOBS_PER_SESSION=1
CORS_ALLOW_CREDENTIALS=false

# Auth rollout
AUTH_MODE=strict
AUTH_PROTECT_API_KEYS=true
AUTH_PROTECT_PROCESSING=true
AUTH_PROTECT_READS=true
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_EMAIL=admin@local.invalid
AUTH_ADMIN_PASSWORD=
# AUTH_ADMIN_PASSWORD_HASH=
AUTH_ALLOW_DEMO_LOGIN=false
FIREBASE_AUTH_ENABLED=false
# Candidate project ID only; replace with the Firebase project ID when enabling.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_HTTP_TIMEOUT_SECONDS=10
# Public Firebase Web config (embedded in the frontend build; never put an Admin key here).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=

# File Upload Configuration
MAX_UPLOAD_SIZE_MB=5120
ALLOWED_EXTENSIONS=mp3,wav,mp4,mpeg,m4a,flac,ogg,opus
AUDIO_UPLOAD_DIRECTORY=database/uploads
# Only the local adapter is implemented. API/Worker/maintenance share this root.
OBJECT_STORAGE_BACKEND=local
AUDIO_ORPHAN_RETENTION_HOURS=24
TRANSCRIPTION_RETENTION_DAYS=0
AUDIT_RETENTION_DAYS=0

# Processing Configuration
DEFAULT_TRANSCRIPTION_MODEL=whisper
# Post-filter validated against the public FLEURS PT-BR fixture and Pyannote sample.
MIN_SEGMENT_DURATION=0
SILENCE_THRESHOLD=-100
MEETING_MINUTES_TIMEOUT_SECONDS=600

# Local Whisper worker (P1-B)
WHISPER_MODEL=large-v3
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_LANGUAGE=pt
WHISPER_BEAM_SIZE=1
WHISPER_MAX_DECODE_CHUNK_SECONDS=300
WHISPER_CPU_THREADS=0
# Account processing policies: zero/unconfigured limits fail closed.
# Configure per-plan values explicitly; examples and rollout: docs/account_plans.md.
PLAN_POLICIES_JSON={}
LOCAL_TRANSCRIPTION_ENABLED=false
LOCAL_TRANSCRIPTION_HOMOLOGATED=false
