# Legacy combined template.
# Prefer one of:
# - .env.dev.example
# - .env.prod.example

# API Keys
HF_TOKEN=your_huggingface_token_here
AAI_API_KEY=your_assemblyai_api_key_here

# Database Configuration (PostgreSQL is the official runtime)
POSTGRES_DB=transcription_db
POSTGRES_USER=transcription
POSTGRES_PASSWORD=change-this-local-password
# Used when running API/Alembic outside Compose; Compose injects host `postgres`.
DATABASE_URL=postgresql+psycopg://transcription:change-this-local-password@localhost:5432/transcription_db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# Redis & Job Queue (RQ)
REDIS_URL=redis://localhost:6379/0

# API Configuration
APP_ENV=dev
API_HOST=0.0.0.0
API_PORT=2020
DEBUG=False

# Security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=usagi-api
JWT_AUDIENCE=usagi-web
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
HF_TOKEN_CONFIGURED=false
AAI_API_KEY_CONFIGURED=false
GEMINI_API_KEY_CONFIGURED=false
GEMINI_MODEL=gemini-2.5-flash
INTELLIGENCE_MAX_INPUT_CHARACTERS=200000
LOGIN_RATE_LIMIT_PER_IP=30
LOGIN_RATE_LIMIT_PER_ACCOUNT=10
UPLOAD_RATE_LIMIT_PER_IP=300
JOB_RATE_LIMIT_PER_USER=30
CORS_ALLOW_CREDENTIALS=false

# Auth rollout
AUTH_MODE=strict
AUTH_PROTECT_API_KEYS=true
AUTH_PROTECT_PROCESSING=true
AUTH_PROTECT_READS=true
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_EMAIL=admin@local.invalid
AUTH_ADMIN_PASSWORD=
# AUTH_ADMIN_PASSWORD_HASH=
AUTH_ALLOW_DEMO_LOGIN=false

# File Upload Configuration
MAX_UPLOAD_SIZE_MB=5120
ALLOWED_EXTENSIONS=mp3,wav,mp4,mpeg,m4a,flac
AUDIO_UPLOAD_DIRECTORY=database/uploads
AUDIO_ORPHAN_RETENTION_HOURS=24
TRANSCRIPTION_RETENTION_DAYS=0
AUDIT_RETENTION_DAYS=0

# Processing Configuration
DEFAULT_TRANSCRIPTION_MODEL=whisper
# Post-filter validated against the public FLEURS PT-BR fixture and Pyannote sample.
MIN_SEGMENT_DURATION=0
SILENCE_THRESHOLD=-100
MEETING_MINUTES_TIMEOUT_SECONDS=600

# Local Whisper worker (P1-B)
WHISPER_MODEL=large-v3
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_LANGUAGE=pt
WHISPER_BEAM_SIZE=1
WHISPER_MAX_DECODE_CHUNK_SECONDS=300
WHISPER_CPU_THREADS=0
