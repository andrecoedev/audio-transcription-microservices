  "segments": [
    {
      "end": 1.56659375,
      "text": "Este é um encontro ficcional.",
      "order": 0,
      "start": 0.03096875,
      "speaker": "SPEAKER_00"
    },
    {
      "end": 3.40596875,
      "text": "Eu sou Alice.",
      "order": 1,
      "start": 2.3934687500000003,
      "speaker": "SPEAKER_00"
    },
    {
      "end": 6.46034375,
      "text": "Hoje estamos a discutir o livro.",
      "order": 2,
      "start": 4.11471875,
      "speaker": "SPEAKER_00"
    },
    {
      "end": 11.03346875,
      "text": "A sala tem mesas quietas e uma área separada para conversa.",
      "order": 3,
      "start": 7.287218750000001,
      "speaker": "SPEAKER_00"
    },
    {
      "end": 15.52221875,
      "text": "Esta reunião é apenas uma discussão, não uma sessão de planejamento.",
      "order": 4,
      "start": 11.89409375,
      "speaker": "SPEAKER_00"
    },
    {
      "end": 17.53034375,
      "text": "E aí, Bruno?",
      "order": 5,
      "start": 16.39971875,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 21.88409375,
      "text": "The Quiet Table Usarius Fall for Reading",
      "order": 6,
      "start": 18.57659375,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 29.86596875,
      "text": "The conversation area helps people exchange ideas without disturbing the leaders.",
      "order": 7,
      "start": 22.91346875,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 33.03846875,
      "text": "We are describing the current.",
      "order": 8,
      "start": 30.844718750000002,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 35.19846875,
      "text": "not assign where",
      "order": 9,
      "start": 33.03846875,
      "speaker": "SPEAKER_00"
    },
    {
      "end": 39.23159375,
      "text": "Os principais tópicos são leitura e conversa quieta.",
      "order": 10,
      "start": 36.27846875,
      "speaker": "SPEAKER_00"
    },
    {
      "end": 43.66971875,
      "text": "Nós não temos tarefas para assinar e não decisões para fazer hoje.",
      "order": 11,
      "start": 40.09221875,
      "speaker": "SPEAKER_00"
    },
    {
      "end": 45.188468750000006,
      "text": "Agrid.",
      "order": 12,
      "start": 44.53034375,
      "speaker": "SPEAKER_01"
    },
    {
