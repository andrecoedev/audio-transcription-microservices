  "segments": [
    {
      "end": 1.56659375,
      "text": "Este é um encontro ficcional.",
      "order": 0,
      "start": 0.03096875,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 3.40596875,
      "text": "Eu sou Alice.",
      "order": 1,
      "start": 2.41034375,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 6.83159375,
      "text": "Talvez nós pudéssemos mudar o formato do workshop.",
      "order": 2,
      "start": 4.199093749999999,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 11.742218750000003,
      "text": "Uma sessão mais curta pode ser útil, mas eu estou apenas sugestionando.",
      "order": 3,
      "start": 7.658468750000001,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 14.25659375,
      "text": "Não há decisão final.",
      "order": 4,
      "start": 12.585968750000003,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 16.26471875,
      "text": "E aí, Bruno?",
      "order": 5,
      "start": 15.15096875,
      "speaker": "SPEAKER_00"
    },
    {
      "end": 20.550968750000003,
      "text": "O ICO DOLSO CONSIDER A LOGGER SESSION",
      "order": 6,
      "start": 17.31096875,
      "speaker": "SPEAKER_00"
    },
    {
      "end": 24.63471875,
      "text": "E aí me noticamente em teoria da Rapson.",
      "order": 7,
      "start": 21.59721875,
      "speaker": "SPEAKER_00"
    },
    {
      "end": 27.55409375,
      "text": "And we have not approved that change.",
      "order": 8,
      "start": 24.83721875,
      "speaker": "SPEAKER_00"
    },
    {
      "end": 27.570968750000002,
      "text": "",
      "order": 9,
      "start": 27.55409375,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 31.45221875,
      "text": "Alguém poderia preparar uma comparação das opções.",
      "order": 10,
      "start": 28.54971875,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 36.10971875,
      "text": "Isso é uma tarefa possível para discussão, não um ensino.",
      "order": 11,
      "start": 32.31284375,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 40.80096875,
      "text": "Não selecionamos uma pessoa responsável ou concordamos em uma hora de salário.",
      "order": 12,
      "start": 36.970343750000005,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 45.86346875,
      "text": "O Ixúdris casuédardet campera sons Ivanídid.",
      "order": 13,
      "start": 41.67846875,
      "speaker": "SPEAKER_00"
    },
    {
      "end": 49.25534375,
      "text": "E I am not accepting the task.",
      "order": 14,
      "start": 46.84221875,
      "speaker": "SPEAKER_00"
    },
    {
      "end": 58.97534375,
      "text": "The workshop format, The Need for a Camperasson, Indianely Spanish Abilities Women Open Questions.",
      "order": 15,
      "start": 50.41971875,
      "speaker": "SPEAKER_00"
    },
    {
      "end": 58.992218750000006,
      "text": "",
      "order": 16,
      "start": 58.97534375,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 61.72596875000001,
      "text": "Deixe-nos acabar a discussão aqui.",
      "order": 17,
      "start": 59.970968750000004,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 67.86846875,
      "text": "Não houve decisão, não houve tarefa assinada e não houve horário concluído.",
      "order": 18,
      "start": 62.55284375,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 69.40409375,
      "text": "E é isso.",
      "order": 19,
      "start": 68.76284375,
      "speaker": "SPEAKER_00"
    },
    {
      "end": 77.63909375,
