{
  "fixture": "B",
  "attempted_real_calls": 2,
  "retries": 0,
  "meeting_id": 15,
  "segments": [
    {
      "end": 1.56659375,
      "text": "Este é um encontro ficcional.",
      "order": 0,
      "start": 0.03096875,
      "speaker": "SPEAKER_00"
    },
    {
      "end": 3.42284375,
      "text": "Eu sou Alice.",
      "order": 1,
      "start": 2.3934687500000003,
      "speaker": "SPEAKER_00"
    },
    {
      "end": 6.24096875,
      "text": "Precisamos de um formato de demonstração.",
      "order": 2,
      "start": 4.1822187500000005,
      "speaker": "SPEAKER_00"
    },
    {
      "end": 10.341593750000001,
      "text": "Proponho usar o templo azul em vez do templo verde.",
      "order": 3,
      "start": 7.000343750000001,
      "speaker": "SPEAKER_00"
    },
    {
      "end": 11.219093750000003,
      "text": "",
      "order": 4,
      "start": 11.20221875,
      "speaker": "SPEAKER_00"
    },
    {
      "end": 12.31596875,
      "text": "E a M. Bruno.",
      "order": 5,
      "start": 11.219093750000003,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 12.349718750000001,
      "text": "",
      "order": 6,
      "start": 12.31596875,
      "speaker": "SPEAKER_00"
    },
    {
      "end": 14.070968750000002,
      "text": "E a gri.",
      "order": 7,
      "start": 13.36221875,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 17.41221875,
      "text": "We have made a final decision.",
      "order": 8,
      "start": 15.066593750000003,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 21.20909375,
      "text": "Use the blue template for the demonstration",
      "order": 9,
      "start": 17.53034375,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 24.17909375,
      "text": "Viz de si já é aprovado.",
      "order": 10,
      "start": 22.28909375,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 24.195968750000002,
      "text": "",
      "order": 11,
      "start": 24.17909375,
      "speaker": "SPEAKER_00"
    },
    {
      "end": 27.098468750000002,
      "text": "Agora assinamos duas tarefas",
      "order": 12,
      "start": 25.191593750000003,
      "speaker": "SPEAKER_00"
    },
    {
      "end": 31.941593750000003,
      "text": "Bruno, por favor prepare as slides para a demonstração em fevereiro.",
      "order": 13,
      "start": 27.97596875,
      "speaker": "SPEAKER_00"
    },
    {
      "end": 36.227843750000005,
      "text": "A pessoa responsável é Bruno e a hora de morte é domingo.",
      "order": 14,
      "start": 32.73471875,
      "speaker": "SPEAKER_00"
    },
    {
      "end": 37.15596875,
      "text": "E aí",
      "order": 15,
      "start": 37.05471875,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 37.89846875,
      "text": "C.",
      "order": 16,
      "start": 37.15596875,
      "speaker": "SPEAKER_00"
    },
    {
      "end": 44.69909375,
      "text": "E, Bruno, will prepare the demonstration slides by Friday.",
      "order": 17,
      "start": 39.079718750000005,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 48.09096875,
      "text": "A segunda tarefa é verificar o projetor.",
      "order": 18,
      "start": 45.67784375,
      "speaker": "SPEAKER_00"
    },
    {
      "end": 55.110968750000005,
      "text": "Esta tarefa é confirmada, mas nenhuma pessoa responsável foi assinada e nenhuma horário foi setado.",
      "order": 19,
      "start": 48.93471875,
      "speaker": "SPEAKER_00"
    },
    {
      "end": 58.84034375,
      "text": "Devemos deixar ambos esses campos sem especificações.",
      "order": 20,
      "start": 55.954718750000005,
      "speaker": "SPEAKER_00"
    },
    {
      "end": 60.42659375,
      "text": "Cade?",
      "order": 21,
      "start": 59.768468750000004,
      "speaker": "SPEAKER_00"
    },
    {
      "end": 67.63221875,
      "text": "Checking the projectarism agreed to ask if no assign donor end no deadline.",
      "order": 22,
      "start": 61.60784375,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 70.43346875,
      "text": "Estes são os dois trabalhos.",
      "order": 23,
      "start": 68.69534375,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 73.89284375000001,
      "text": "and determine what is our decision.",
      "order": 24,
      "start": 70.61909375,
      "speaker": "SPEAKER_01"
    }
  ],
