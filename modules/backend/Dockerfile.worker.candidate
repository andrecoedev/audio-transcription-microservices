# Disposable P2-C.1 experiment. Build with --build-arg BASE_IMAGE=<stable worker tag>.
# Do not use as the production worker until quality, GPU and security gates pass.
ARG BASE_IMAGE=p2c-worker
FROM ${BASE_IMAGE}

# PyTorch publishes this triplet for CUDA 12.8. TorchCodec 0.10 pairs with 2.10.
RUN python -m pip install --no-cache-dir --upgrade \
    --index-url https://download.pytorch.org/whl/cu128 \
    torch==2.10.0 torchvision==0.25.0 torchaudio==2.10.0
RUN python -m pip install --no-cache-dir --upgrade \
    torchcodec==0.10.0 pyannote.audio==4.0.7 pyannote.core==6.0.1

COPY modules/backend/run_worker.py /app/modules/backend/run_worker.py
COPY modules/backend/src/services/diarization_engine.py /app/modules/backend/src/services/diarization_engine.py
COPY modules/backend/src/config.py /app/modules/backend/src/config.py
COPY modules/backend/src/services/diarization_compat.py /app/modules/backend/src/services/diarization_compat.py
COPY modules/backend/benchmarks/benchmark_diarization_robustness.py /app/modules/backend/benchmarks/benchmark_diarization_robustness.py
COPY modules/backend/benchmarks/compare_diarization_runs.py /app/modules/backend/benchmarks/compare_diarization_runs.py
COPY modules/backend/scripts /app/modules/backend/scripts
COPY modules/backend/tests /app/modules/backend/tests

RUN python -m pip check
